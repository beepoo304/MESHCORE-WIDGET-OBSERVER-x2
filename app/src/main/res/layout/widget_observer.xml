<?xml version="1.0" encoding="utf-8"?>
<!-- Pełny wariant widgetu: minimalistyczny układ, jedna czcionka (Roboto), 3 rozmiary, cyfry o stałej szerokości.
     Plik generowany wspólnym szablonem razem z widget_observer_compact.xml; te same id. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="10dp" android:paddingBottom="10dp"
    android:background="@drawable/widget_bg">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MESH" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="17sp" android:maxLines="1"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CORE" android:textColor="#6EF015" android:textStyle="bold" android:textSize="17sp" android:maxLines="1"/>
        <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
        <TextView android:id="@+id/mapping_icon" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="MAPPER" android:textColor="#4FC3F7" android:textStyle="bold" android:textSize="11sp"
            android:letterSpacing="0.08" android:maxLines="1" android:visibility="gone"
            android:contentDescription="Ktoś mapuje w zasięgu Observera"/>
        <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
        <ImageView android:id="@+id/refresh_icon" android:layout_width="18dp" android:layout_height="18dp"
            android:src="@drawable/ic_refresh" android:contentDescription="@null"/>
        <ProgressBar android:id="@+id/refresh_spinner"
            android:layout_width="18dp" android:layout_height="18dp" android:indeterminate="true"
            android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/ic_refresh_spin"
            android:indeterminateDuration="900" android:visibility="gone"/>
        <TextView android:id="@+id/interval_text" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="5dp" android:text="00s" android:textColor="#FFFFFF" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:maxLines="1"/>
    </LinearLayout>

    <TextView android:id="@+id/obs_name" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:text="—" android:textColor="#FFFFFF" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:maxLines="1" android:ellipsize="end"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/obs_hash" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="----" android:textColor="#6B6F69" android:textSize="10sp" android:fontFamily="monospace"
            android:singleLine="true" android:maxLines="1" android:ellipsize="end"/>
        <ImageView android:id="@+id/copy_key" android:layout_width="30dp" android:layout_height="26dp"
            android:paddingStart="8dp" android:paddingEnd="4dp" android:paddingTop="4dp" android:paddingBottom="4dp"
            android:src="@drawable/ic_copy" android:contentDescription="Kopiuj klucz"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="3" android:text="BROKER" android:textSize="10sp" android:fontFamily="sans-serif-medium" android:textColor="#8A8F88" android:letterSpacing="0.04" android:maxLines="1"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:gravity="center" android:text="PKT/H" android:textSize="10sp" android:fontFamily="sans-serif-medium" android:textColor="#8A8F88" android:letterSpacing="0.04" android:maxLines="1"/>
        <FrameLayout android:id="@+id/hdr_total_col" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="3">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="TOTAL" android:textSize="10sp" android:fontFamily="sans-serif-medium" android:textColor="#8A8F88" android:letterSpacing="0.04" android:maxLines="1"/>
        </FrameLayout>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="3" android:layout_marginStart="8dp" android:gravity="center" android:text="LAST" android:textSize="10sp" android:fontFamily="sans-serif-medium" android:textColor="#8A8F88" android:letterSpacing="0.04" android:maxLines="1"/>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="1dp" android:background="#1F231E"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="22dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="4dp" android:paddingBottom="4dp">
        <TextView android:id="@+id/m1_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="3" android:layout_gravity="center_vertical" android:text="MQTT1" android:textColor="#6B6B6B" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:maxLines="1"/>
        <TextView android:id="@+id/m1_hour" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:layout_gravity="center_vertical" android:gravity="center" android:text="—" android:textColor="#FFFFFF" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:maxLines="1"/>
        <FrameLayout android:id="@+id/m1_total_col" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="3" android:layout_gravity="center_vertical">
            <TextView android:id="@+id/m1_total" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="—" android:textColor="#FFFFFF" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:maxLines="1"/>
        </FrameLayout>
        <TextView android:id="@+id/m1_last" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="3" android:layout_gravity="center_vertical" android:layout_marginStart="8dp" android:gravity="center" android:background="@drawable/pill_gray" android:text="—" android:textColor="#000000" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:maxLines="1" android:paddingTop="1dp" android:paddingBottom="1dp"/>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="1dp" android:background="#1F231E"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="22dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="4dp" android:paddingBottom="4dp">
        <TextView android:id="@+id/m2_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="3" android:layout_gravity="center_vertical" android:text="MQTT2" android:textColor="#6B6B6B" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:maxLines="1"/>
        <TextView android:id="@+id/m2_hour" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:layout_gravity="center_vertical" android:gravity="center" android:text="—" android:textColor="#FFFFFF" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:maxLines="1"/>
        <FrameLayout android:id="@+id/m2_total_col" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="3" android:layout_gravity="center_vertical">
            <TextView android:id="@+id/m2_total" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="—" android:textColor="#FFFFFF" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:maxLines="1"/>
        </FrameLayout>
        <TextView android:id="@+id/m2_last" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="3" android:layout_gravity="center_vertical" android:layout_marginStart="8dp" android:gravity="center" android:background="@drawable/pill_gray" android:text="—" android:textColor="#000000" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:maxLines="1" android:paddingTop="1dp" android:paddingBottom="1dp"/>
    </LinearLayout>
</LinearLayout>
