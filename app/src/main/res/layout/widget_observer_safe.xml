<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/safe_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="12dp"
    android:background="#000000">
    <TextView android:id="@+id/safe_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="MESHCORE" android:textColor="#6EF015" android:textStyle="bold" android:textSize="22sp"/>
    <TextView android:id="@+id/safe_text" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="—" android:textColor="#FFFFFF" android:textSize="16sp" android:gravity="center"/>
</LinearLayout>
